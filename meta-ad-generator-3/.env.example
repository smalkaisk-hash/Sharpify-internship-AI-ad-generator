# ── OpenAI (required for all pipeline steps) ──────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Model overrides (optional) ────────────────────────────────────────────────
# Default for all steps: gpt-4o
# Use gpt-4o-mini for copy/refine steps to reduce cost (design step always uses gpt-4o)
COPY_MODEL=gpt-4o
DESIGN_MODEL=gpt-4o

# ── Gemini Imagen (optional — only needed for AI image generation) ─────────────
GEMINI_API_KEY=

# ── Meta API (optional — only needed to push ads to Meta) ─────────────────────
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_ACCOUNT_ENG=
META_ACCOUNT_LV=

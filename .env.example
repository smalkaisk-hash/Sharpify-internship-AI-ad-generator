# ── Anthropic (required for meta-ad-generator-3 pipeline) ────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Model overrides (optional) ────────────────────────────────────────────────
# Defaults: COPY_MODEL=claude-haiku-4-5-20251001  DESIGN_MODEL=claude-sonnet-4-6
COPY_MODEL=claude-haiku-4-5-20251001
DESIGN_MODEL=claude-sonnet-4-6

# ── Gemini Imagen (optional — AI image generation) ────────────────────────────
GEMINI_API_KEY=

# ── Meta API (push ads to Meta) ───────────────────────────────────────────────
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_ACCOUNT_ENG=
META_ACCOUNT_LV=
